# ============================================
# COMAS TECH — BACKEND — PLANTILLA DE CONFIGURACION
# 1) Copia este archivo con el nombre: .env
# 2) Completa los valores reales (sobre todo DB_PASSWORD y JWT_SECRET)
# 3) El .env NUNCA se sube a GitHub (ya esta en .gitignore)
# ============================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_CLAVE_DE_MYSQL_AQUI
DB_NAME=comas_tech

# --- Seguridad JWT ---
# IMPORTANTE: minimo 32 caracteres, larga y aleatoria. Nunca uses la de ejemplo.
# Sin una clave valida, el servidor NO arranca (proteccion activa).
JWT_SECRET=genera_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# --- CORS: dominio de tu frontend (* solo para pruebas locales) ---
CORS_ORIGIN=http://localhost:5173

# --- Puerto del servidor ---
PORT=4000
